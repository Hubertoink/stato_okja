# Pin a stable release for production. Use "latest" only when automatic updates are intended.
STATO_IMAGE_TAG=1.0.10
# The installer derives this from STATO_IMAGE_TAG. It uses the frontend image
# built specifically for the internal /api proxy used by a container stack.
STATO_FRONTEND_IMAGE_TAG=stack-1.0.10

TZ=Europe/Berlin
APP_ORIGIN=https://app.example.org
CORS_ORIGINS=https://app.example.org

POSTGRES_DB=stato_prod
POSTGRES_USER=stato_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# The first password is assigned once in the browser when INITIAL_SETUP_ENABLED=true.
SUPERADMIN_EMAIL=admin@example.org
SUPERADMIN_PASSWORD=

PUBLIC_APP_NAME=StatO
PUBLIC_ORG_NAME=
PUBLIC_LOGIN_SUBTITLE=OKJA Statistik und Dokumentation

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
INVITE_TOKEN_EXPIRATION=24h
RESET_TOKEN_EXPIRATION=1h
PASSWORD_RESET_MODE=email
AUTH_2FA_ENABLED=false
AUTH_2FA_CODE_TTL=600

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.org

BACKUP_RETENTION_DAYS=14
