# Environment
NODE_ENV=development
APP_ENV=development
STRICT_SECURITY_MODE=false

# Server
PORT=3000
API_PREFIX=api
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stato_user
DB_PASSWORD=stato_dev_password
DB_DATABASE=stato_dev
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=true
DB_REQUIRE_SSL=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_2FA_ENABLED=false
AUTH_2FA_CODE_TTL=600
INVITE_TOKEN_EXPIRATION=7d
RESET_TOKEN_EXPIRATION=1h
PASSWORD_RESET_MODE=email
USER_PROVISIONING_MODE=email

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=stato-attachments

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public branding (optional) – shown on login page
# Frontend fetches this via GET /api/auth/public-config
PUBLIC_APP_NAME=StatO
PUBLIC_ORG_NAME=
PUBLIC_LOGIN_SUBTITLE=OKJA Statistik & Dokumentation
# Polling fuer Dashboard/Aktivitaeten/Statistik in Millisekunden; 0 deaktiviert Polling.
PUBLIC_LIVE_REFRESH_INTERVAL_MS=15000

# Rechtstexte im Repository-Hauptverzeichnis (manifest.json und Markdown-Dateien)
LEGAL_CONTENT_DIR=../legal

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# SMTP (for invite/reset emails)
# For local testing with Mailpit (no auth):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# For docker-compose network, backend can use host 'mailpit' and port 1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@stato.local

# Seed superadmin (email is enforced to receive reset/invite mails during development)
SUPERADMIN_EMAIL=admin@example.org
# SUPERADMIN_PASSWORD=admin00
SUPERADMIN_EMAIL_FORCE=false
SUPERADMIN_PASSWORD_FORCE=false
