# Copy these values into the variable form shown by ZimaOS during Custom-App import.
# Never reuse the example secrets in a real installation.

# Release image version. Use an immutable release, not "latest".
STATO_VERSION=1.4.1

# ZimaOS publishes this port. Choose a free port and use the same address below.
WEBUI_PORT=8088
APP_ORIGIN=http://192.168.1.50:8088
CORS_ORIGINS=http://192.168.1.50:8088
AUTH_REFRESH_COOKIE_SECURE=false

POSTGRES_DB=stato_prod
POSTGRES_USER=stato_user
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_WITH_AT_LEAST_48_CHARACTERS

SUPERADMIN_EMAIL=admin@example.org
PUBLIC_ORG_NAME=Meine Organisation
TZ=Europe/Berlin

# For a local installation without mail, keep these defaults.
PASSWORD_RESET_MODE=admin_temp_password
USER_PROVISIONING_MODE=local

# Set this to true only after StatO is reached through HTTPS and APP_ORIGIN /
# CORS_ORIGINS are changed to that HTTPS address.
# AUTH_REFRESH_COOKIE_SECURE=true

# Optional SMTP settings for email invitations, password reset and 2FA.
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_USER=no-reply@example.org
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=no-reply@example.org
