# Copy to .env.production and adjust values for hosted/off-prem production.

NODE_ENV=production
APP_ENV=production
STRICT_SECURITY_MODE=true
TZ=Europe/Berlin

# Public frontend URL and API prefix
APP_ORIGIN=https://app.example.com
CORS_ORIGINS=https://app.example.com
API_PREFIX=api
TRUST_PROXY=true
SWAGGER_ENABLED=false

# Strong, long, stable secret. Do not rotate casually.
# Example generation: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
AUTH_REFRESH_COOKIE_SAMESITE=lax
INVITE_TOKEN_EXPIRATION=24h
RESET_TOKEN_EXPIRATION=1h

# Optional email-based 2FA. Requires working SMTP when true.
AUTH_2FA_ENABLED=false
AUTH_2FA_CODE_TTL=600

# Password reset mode: email | admin_temp_password | hybrid
PASSWORD_RESET_MODE=email

# Postgres container defaults. Override DB_* below for an external database.
POSTGRES_DB=stato_prod
POSTGRES_USER=stato_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password

DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=stato_user
DB_PASSWORD=replace-with-a-strong-db-password
DB_DATABASE=stato_prod
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# External Postgres with TLS:
# DB_HOST=db.example.com
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_REQUIRE_SSL=true
# Internal Compose Postgres usually stays without TLS:
DB_REQUIRE_SSL=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Rate limits
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10

# Initial superadmin user. Force flags are only for deliberate admin resets.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-initial-password
SUPERADMIN_EMAIL_FORCE=false
SUPERADMIN_PASSWORD_FORCE=false

# Public login/branding config
PUBLIC_APP_NAME=StatO
PUBLIC_ORG_NAME=
PUBLIC_LOGIN_SUBTITLE=OKJA Statistik und Dokumentation
PUBLIC_LIVE_REFRESH_INTERVAL_MS=30000
STATS_OVERVIEW_CACHE_TTL_MS=30000

# Feature flags
ENABLE_ORG_MOVE=false
VITE_ENABLE_DEV_TOOLS=false

# Optional SMTP for invites, password reset and 2FA
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_PASS=replace-with-smtp-password
# SMTP_FROM=no-reply@example.com
