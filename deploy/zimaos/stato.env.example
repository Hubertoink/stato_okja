# These are all values requested by the ZimaOS import form.
# Generate DB/JWT secrets and a separate setup code once; preserve them on updates.

STATO_VERSION=1.9.1
WEBUI_PORT=8088
STATO_URL=http://192.168.1.50:8088
STATO_HTTPS=false

POSTGRES_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
