APP_ORIGIN=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Muss ein zufaelliger Wert mit mindestens 32 Zeichen sein.
# Beispiel-Generierung:
# openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

POSTGRES_DB=stato_prod
POSTGRES_USER=stato_user
POSTGRES_PASSWORD=replace-with-a-strong-db-password

DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_DATABASE=${POSTGRES_DB}
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
ENABLE_ORG_MOVE=false
PUBLIC_LIVE_REFRESH_INTERVAL_MS=15000

# Default in Production: fuer externe Postgres-Datenbanken wird SSL erwartet.
# Bei einer bewusst vertrauten, nicht-oeffentlichen DB ohne SSL kann explizit deaktiviert werden.
# DB_REQUIRE_SSL=false

# Fuer externe Postgres-Datenbanken mit TLS aktivieren.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# Optional SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com