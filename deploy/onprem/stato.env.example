# StatO On-Prem configuration
#
# This is the template bundled with a StatO On-Prem release. The installer
# stores the real configuration in config/stato.env, outside the release files.
#
# The installers copy this file to config/stato.env and replace all
# GENERATED_BY_INSTALLER values with individual secrets. If you copy the file
# manually, replace those values before starting Docker. Never commit the real
# config/stato.env; it contains credentials.

# -----------------------------------------------------------------------------
# Database (required)
# Changing DB name/user later does not rename an initialized database. The
# installers do synchronize a changed password with an existing database.
# -----------------------------------------------------------------------------
POSTGRES_DB=stato_prod
POSTGRES_USER=stato_user
POSTGRES_PASSWORD=GENERATED_BY_INSTALLER

# -----------------------------------------------------------------------------
# Public address and Docker port
# Use the final HTTPS URL here as soon as a reverse proxy/TLS is configured.
# CORS_ORIGINS accepts one origin or a comma-separated list without paths.
# -----------------------------------------------------------------------------
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
APP_ORIGIN=http://localhost
CORS_ORIGINS=http://localhost
API_PREFIX=api
TRUST_PROXY=true

# Optional internal HTTPS with the bundled Caddy profile. Set both values and
# rerun the installer. It then exposes HTTPS on HTTPS_PORT and binds StatO HTTP
# to 127.0.0.1 only. See docs/CADDY_INTERNAL_TLS_ONPREM.md.
STATO_TLS_MODE=off
STATO_PUBLIC_HOST=
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443

# false makes the first local HTTP start usable. Set this to true as soon as
# APP_ORIGIN uses HTTPS. Secure cookies must not be sent over plain HTTP.
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Authentication and security (JWT_SECRET is required and must stay stable)
# -----------------------------------------------------------------------------
JWT_SECRET=GENERATED_BY_INSTALLER
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
INVITE_TOKEN_EXPIRATION=24h
RESET_TOKEN_EXPIRATION=1h
AUTH_2FA_ENABLED=false
AUTH_2FA_CODE_TTL=600
STRICT_SECURITY_MODE=true
SWAGGER_ENABLED=false

# Initial account for a new/empty database. The installer enables the one-time
# setup screen, where the password is chosen on first access and stored only as
# a password hash in the database. FORCE flags stay false except during an
# intentional admin reset.
SUPERADMIN_EMAIL=admin@stato.local
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAIL_FORCE=false
SUPERADMIN_PASSWORD_FORCE=false
INITIAL_SETUP_ENABLED=true
INITIAL_SETUP_TOKEN=GENERATED_BY_INSTALLER

# -----------------------------------------------------------------------------
# Database schema and connection policy
# Keep migrations enabled. TLS settings below are only for an external DB;
# the bundled postgres service communicates inside the private Docker network.
# -----------------------------------------------------------------------------
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_BOOTSTRAP_ON_EMPTY=true
DB_LOGGING=false
DB_REQUIRE_SSL=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# Password reset / email
# admin_temp_password works without SMTP. For email or hybrid mode, fill all
# SMTP values. AUTH_2FA_ENABLED=true also requires working SMTP.
# -----------------------------------------------------------------------------
PASSWORD_RESET_MODE=admin_temp_password
# Standard ohne SMTP: local. Der Admin setzt beim Anlegen ein temporäres
# Passwort, das beim ersten Login geändert werden muss. Nach Einrichtung und
# Test des SMTP-Versands kann die IT auf email umstellen.
USER_PROVISIONING_MODE=local
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_USER=mailer@example.org
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=no-reply@example.org

# -----------------------------------------------------------------------------
# Branding and runtime behavior
# -----------------------------------------------------------------------------
# Wird vom Release-Installer auf die installierte StatO-Version gesetzt. Fuer
# einen manuellen Betrieb muss hier eine veröffentlichte Version stehen.
# Backend and backup use the immutable release version. The On-Prem frontend
# has its own tag because its Nginx routes /api only to the internal backend.
STATO_IMAGE_TAG=
STATO_FRONTEND_IMAGE_TAG=
PUBLIC_APP_NAME=StatO
PUBLIC_ORG_NAME=Meine Organisation
PUBLIC_LOGIN_SUBTITLE=OKJA Statistik und Dokumentation
# Polling interval in milliseconds; 0 disables polling.
PUBLIC_LIVE_REFRESH_INTERVAL_MS=30000
# Statistics overview cache in milliseconds; 0 disables the cache.
STATS_OVERVIEW_CACHE_TTL_MS=0

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10
# Account lockout after repeated incorrect passwords.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# These flags are compiled into the frontend. Rebuild after changing them.
VITE_ENABLE_DEV_TOOLS=false
ENABLE_ORG_MOVE=false
# Globaler Schalter fuer ProzessO. Einzelne Organisationen werden weiterhin
# separat durch einen Superadmin freigeschaltet.
ENABLE_PROCESSES=true

TZ=Europe/Berlin
BACKUP_RETENTION_DAYS=14
# Automatic backup on startup and every 24 hours; 0 disables scheduling.
BACKUP_INTERVAL_SECONDS=86400
# Set an absolute path on separate storage for protection against host loss.
BACKUP_COPY_DIR=./backup-export
APP_ENV=production
NODE_ENV=production
