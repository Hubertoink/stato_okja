## Copy to .env.onprem and adjust values

POSTGRES_DB=stato_prod
POSTGRES_USER=stato_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG

# Domain where your on-prem frontend is reachable
APP_ORIGIN=http://localhost:80
CORS_ORIGINS=http://localhost:80
API_PREFIX=api
TRUST_PROXY=true

# Strong, long, stable secret (do not rotate casually)
JWT_SECRET=CHANGE_ME_SUPER_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRATION=12h
AUTH_2FA_ENABLED=false
AUTH_2FA_CODE_TTL=600
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false
SWAGGER_ENABLED=false
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10

# For external Postgres only; keep false for the bundled local postgres service
DB_REQUIRE_SSL=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Password reset mode for this instance:
# email | admin_temp_password | hybrid
PASSWORD_RESET_MODE=admin_temp_password

# Initial superadmin user (created/ensured on backend startup)
SUPERADMIN_EMAIL=admin@example.org
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_2026!
# Keep false for normal operation.
# If set to true, the backend overwrites the existing superadmin email on every backend start.
SUPERADMIN_EMAIL_FORCE=false
# Keep false for normal operation.
# If set to true, the backend overwrites the existing superadmin password on every backend start
# with the value from SUPERADMIN_PASSWORD.
SUPERADMIN_PASSWORD_FORCE=false

PUBLIC_APP_NAME=StatO
PUBLIC_ORG_NAME=Meine Organisation
PUBLIC_LOGIN_SUBTITLE=OKJA Statistik und Dokumentation
# Polling fuer Dashboard/Aktivitaeten/Statistik in Millisekunden; 0 deaktiviert Polling.
PUBLIC_LIVE_REFRESH_INTERVAL_MS=15000

# Optional SMTP
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.org

# Container/application timezone
TZ=Europe/Berlin

# Frontend feature flag for the Superadmin Dev Tools menu/UI
# Set to true only when the dev tools should be exposed in the frontend build
VITE_ENABLE_DEV_TOOLS=false
APP_ENV=production
NODE_ENV=production