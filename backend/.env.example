# Environment
NODE_ENV=development

# Server
PORT=3000
API_PREFIX=api
APP_ORIGIN=http://localhost:5173

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stato_user
DB_PASSWORD=stato_dev_password
DB_DATABASE=stato_dev
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
INVITE_TOKEN_EXPIRATION=7d
RESET_TOKEN_EXPIRATION=1h

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=stato-attachments

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public branding (optional) – shown on login page
# Frontend fetches this via GET /api/auth/public-config
PUBLIC_APP_NAME=StatO
PUBLIC_ORG_NAME=
PUBLIC_LOGIN_SUBTITLE=OKJA Statistik & Dokumentation

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# SMTP (for invite/reset emails)
# For local testing with Mailpit (no auth):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# For docker-compose network, backend can use host 'mailpit' and port 1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@stato.local

# Seed superadmin (email is enforced to receive reset/invite mails during development)
SUPERADMIN_EMAIL=admin@example.org
# SUPERADMIN_PASSWORD=admin00
